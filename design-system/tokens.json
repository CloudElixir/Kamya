{
  "meta": {
    "name": "KAMYA Design System",
    "tagline": "From Darkness To Divine Light",
    "platform": ["iOS", "Android"],
    "frame": { "width": 390, "height": 844 }
  },
  "color": {
    "background": {
      "cosmicNavy": { "hex": "#060B2D", "rgb": "6, 11, 45" },
      "spiritualPurple": { "hex": "#1C1240", "rgb": "28, 18, 64" },
      "gradient": "linear-gradient(180deg, #060B2D 0%, #1C1240 50%, #0D0828 100%)"
    },
    "accent": {
      "motionGold": { "hex": "#D4AF37", "rgb": "212, 175, 55" },
      "softAmber": { "hex": "#F3C96A", "rgb": "243, 201, 106" }
    },
    "text": {
      "primary": { "hex": "#FFFFFF" },
      "secondary": { "hex": "#E8E0D4", "name": "softCream" },
      "tertiary": { "hex": "#B8A88A", "name": "mutedGold" },
      "accent": { "hex": "#F3C96A", "name": "lightGold" }
    },
    "semantic": {
      "success": "#4ADE80",
      "error": "#F87171",
      "online": "#22C55E",
      "warning": "#FBBF24"
    },
    "glass": {
      "fill": "rgba(255, 255, 255, 0.06)",
      "border": "rgba(212, 175, 55, 0.35)",
      "highlight": "rgba(243, 201, 106, 0.12)"
    }
  },
  "typography": {
    "fontFamily": {
      "heading": "Playfair Display",
      "body": "DM Sans",
      "accent": "Cormorant Garamond"
    },
    "scale": {
      "display": { "size": 36, "lineHeight": 44, "weight": 700, "font": "heading" },
      "h1": { "size": 28, "lineHeight": 36, "weight": 700, "font": "heading" },
      "h2": { "size": 22, "lineHeight": 28, "weight": 600, "font": "heading" },
      "h3": { "size": 18, "lineHeight": 24, "weight": 600, "font": "heading" },
      "body": { "size": 15, "lineHeight": 22, "weight": 400, "font": "body" },
      "bodySmall": { "size": 13, "lineHeight": 18, "weight": 400, "font": "body" },
      "caption": { "size": 11, "lineHeight": 14, "weight": 500, "font": "body" },
      "label": { "size": 12, "lineHeight": 16, "weight": 600, "font": "body", "letterSpacing": 0.8 }
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "2xl": 48
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "full": 999
  },
  "shadow": {
    "card": "0 8px 32px rgba(0, 0, 0, 0.4)",
    "glow": "0 0 24px rgba(212, 175, 55, 0.25)",
    "elevated": "0 16px 48px rgba(0, 0, 0, 0.5)"
  },
  "components": {
    "button": {
      "height": { "sm": 40, "md": 48, "lg": 56 },
      "paddingX": 24
    },
    "input": {
      "height": 52,
      "radius": 12
    },
    "card": {
      "padding": 16,
      "radius": 16
    },
    "bottomNav": {
      "height": 80
    }
  }
}
